# CLN + Boltz hold plugin, pinned and checksum-verified for regtest.
# The release asset is linux/amd64 only; build ARM from source instead.
FROM elementsproject/lightningd:v24.08.1

ARG HOLD_VERSION=v0.3.3
ARG HOLD_SHA256=f9d916430fb70a3d75089f2d1b88d5d71d4987ef79933035978c1f44aab84be5
ADD https://github.com/BoltzExchange/hold/releases/download/${HOLD_VERSION}/hold-linux-amd64.tar.gz /tmp/hold.tar.gz

RUN echo "${HOLD_SHA256}  /tmp/hold.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/hold.tar.gz -C /tmp \
    && install -m 0755 /tmp/build/hold-linux-amd64 /usr/local/bin/hold \
    && rm -rf /tmp/hold.tar.gz /tmp/build
